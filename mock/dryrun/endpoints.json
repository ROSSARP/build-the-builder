{
 "service": "Freya Bank collections tools",
 "worker_name": "freya-bank-collections-tools-mock",
 "base_path": "/v1",
 "health_path": "/health",
 "state_model": "cross-call",
 "kv_optional": true,
 "endpoints": [
  {
   "method": "POST",
   "path": "/v1/verify_identity",
   "source": "contract",
   "summary": "Check one security answer. Three wrong answers in total end the check."
  },
  {
   "method": "POST",
   "path": "/v1/get_account",
   "source": "contract",
   "summary": "The late products. Refused until both questions are passed."
  },
  {
   "method": "POST",
   "path": "/v1/create_promise",
   "source": "contract",
   "summary": "Record a payment promise. One per product."
  },
  {
   "method": "POST",
   "path": "/v1/add_note",
   "source": "contract",
   "summary": "Brief B: record why a product ended without a promise."
  },
  {
   "method": "POST",
   "path": "/v1/schedule_callback",
   "source": "contract",
   "summary": "Book a callback."
  },
  {
   "method": "POST",
   "path": "/v1/transfer_to_agent",
   "source": "contract",
   "summary": "Hand the call to a person."
  },
  {
   "method": "POST",
   "path": "/v1/close_call",
   "source": "contract",
   "summary": "End the call. Always the last tool call. Nothing is accepted after it."
  },
  {
   "method": "GET",
   "path": "/v1/practice/ledger/{customer_id}",
   "source": "ledger",
   "summary": "the ledger a scorer reads — every call in order plus the final outcome/reason, promises, notes, callbacks, transfers and identity state"
  },
  {
   "method": "GET",
   "path": "/v1/practice/ledger",
   "source": "ledger",
   "summary": "all live ledgers, keyed by customer_id"
  },
  {
   "method": "POST",
   "path": "/v1/practice/sessions",
   "source": "sessions",
   "summary": "open a fresh session for a seed case"
  },
  {
   "method": "GET",
   "path": "/health",
   "source": "health",
   "summary": "liveness; must return 200"
  }
 ],
 "get_probes": [
  {
   "path": "/health"
  },
  {
   "path": "/v1/practice/ledger/PUB-01",
   "probe_of": "/v1/practice/ledger/{customer_id}",
   "source": "ledger"
  },
  {
   "path": "/v1/practice/ledger",
   "probe_of": "/v1/practice/ledger",
   "source": "ledger"
  }
 ]
}
