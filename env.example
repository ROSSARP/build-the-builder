# Build the Builder — environment template (PLACEHOLDERS ONLY, never real keys).
#
# This is the safe reference. The repository's own env.sh is shipped configured
# for the team/organiser clone; use this template for your own values:
#
#     cp env.example env.sh      # then edit env.sh and: source env.sh
#
# ---------------------------------------------------------------------------
# Freya (required to build, save and test phone agents)
# ---------------------------------------------------------------------------
export FREYA_API_KEY=fak_REPLACE_WITH_YOUR_FREYA_API_KEY
export FREYA_API_URL=https://staging-app.freyavoice.ai
# Any secret of 16+ characters your team picks; keep it the same every run.
export FREYA_BANK_TEAM_KEY=REPLACE_WITH_A_TEAM_SECRET_16_CHARS_OR_MORE

# ---------------------------------------------------------------------------
# LLM backend behind the `claude` CLI (optional)
#
# builder/build.py makes its model calls by running `claude -p ...` as a
# subprocess. It uses your existing `claude` login by default. To point it at
# any Claude-compatible backend instead, set the standard variables below —
# they are inherited by the subprocess. No key from this team is needed.
# ---------------------------------------------------------------------------
# export ANTHROPIC_BASE_URL=https://your-backend.example.com
# export ANTHROPIC_AUTH_TOKEN=REPLACE_WITH_YOUR_BACKEND_TOKEN
# export ANTHROPIC_API_KEY=sk-ant-REPLACE_ME          # alternative to AUTH_TOKEN
# export ANTHROPIC_MODEL=REPLACE_WITH_YOUR_MODEL_ID  # session default; see note

# The builder always passes --model explicitly, so a compatible gateway that
# ignores or remaps the requested model name serves the call regardless. To
# change the name the builder requests:
# export BUILDER_MODEL=claude-sonnet-5-5      # builder/build.py model calls
# export LOCAL_SIM_MODEL=claude-sonnet-5-5    # tests/local_sim.py model calls
#
# Note: builder/build.py filters enclosing-session model overrides
# (CLAUDE_MODEL*, ANTHROPIC_DEFAULT_*, CLAUDE_CODE_SUBAGENT_MODEL,
# ANTHROPIC_MODEL) out of the subprocess environment so that an enclosing
# Claude Code session cannot change the builder's chosen model.
